<Window x:Class="Shoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shoes"
        mc:Ignorable="d"
        Title="ООО Обувь - Главная" Height="500" Width="850" WindowStartupLocation="CenterScreen"  Icon="/Icon.png"
        Loaded="Window_Loaded" FontFamily="Times New Roman" Background="#FFFFFF">

    <Window.Resources>

        <Style x:Key="ProductRowStyle" TargetType="DataGridRow">
            
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblUserInfo" Grid.Column="0" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>

                <Button x:Name="btnLogout" Grid.Column="1" Content="Выйти" Click="btnExit_Click" 
                        Padding="15,5" Background="#00FA9A" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="10" x:Name="MainTabControl">
            <TabItem Header="Товары">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="SearchFilterPanel" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Width="200" Margin="0,0,15,0" Height="25"/>
                        <TextBlock Text="Скидка:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox Width="120" Height="25"/>
                    </StackPanel>

                    <DataGrid x:Name="dgProducts" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="True" 
                              HeadersVisibility="Column" RowStyle="{StaticResource ProductRowStyle}"/>

                    <StackPanel x:Name="AdminButtonsPanel" Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Добавить товар" Padding="15,5" Margin="0,0,10,0" Background="#00FA9A" FontWeight="Bold"/>
                        <Button Content="Редактировать" Padding="15,5" Margin="0,0,10,0" Background="#00FA9A" FontWeight="Bold"/>
                        <Button Content="Удалить" Padding="15,5" Background="#00FA9A" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="OrdersTabItem" Header="Заказы">
                <DataGrid x:Name="dgOrders" AutoGenerateColumns="True" IsReadOnly="True" HeadersVisibility="Column"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
